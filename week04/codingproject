    public static String myString(String word, int n) {
    	// StringBuilder is efficient for concatenation
        StringBuilder result = new StringBuilder(); 
        for (int i = 0; i < n; i++) {
            result.append(word); // Concatenate
        }
        return result.toString(); // Convert StringBuilder to String and return to line
	        
