	// Method determines if a drink will be bought or not
    public static boolean willBuyDrink(boolean isHotOutside, double moneyInPocket) {
        // Return true if it's hot outside and the money in pocket is greater than 10.50
        return isHotOutside && moneyInPocket > 10.50;
