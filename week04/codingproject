	 public static double calculateAverage1(double[] numbers) {
	        double sum = 0;
	        
	        // Calculate the sum of all elements in the array
	        for (double number : numbers) {
	            sum += number;
	        }
	        
	        // Return the average (sum divided by the number of elements)
	        return sum / numbers.length;
	    }

	    // Method to compare the averages of two arrays
	    public static boolean isFirstAverageGreaterThanSecond(double[] array1, double[] array2) {
	        double average1 = calculateAverage(array1);
	        double average2 = calculateAverage(array2);
	        
	        // Return true if the average of array1 is greater than the average of array2
	        return average1 > average2;
	    }
	
	// Method to calculate the average of elements in the array
    public static double calculateAverage(double[] numbers) {
        double sum = 0;
        
        // Calculate the sum of all elements in the array
        for (double number : numbers) {
            sum += number; }
    
    return sum / numbers.length; }
	
	
	public static boolean isSumGreaterThan100(int[] numbers) {
        int sum = 0;
        
        // Calculate the sum of all elements in the array
        for (int number : numbers) {
            sum += number;
        }
        
        // Return true if sum is greater than 100, else false
        return sum > 100; }
	
